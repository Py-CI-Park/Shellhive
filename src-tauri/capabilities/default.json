{
  "$schema": "https://schemas.tauri.app/config/2",
  "identifier": "default",
  "description": "Shellhive default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:window:default",
    "dialog:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    },
    {
      "identifier": "core:app:allow-app-show",
      "allow": []
    },
    {
      "identifier": "core:window:allow-close",
      "allow": []
    },
    {
      "identifier": "core:window:allow-set-focus",
      "allow": []
    }
  ]
}
